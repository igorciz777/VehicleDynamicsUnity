MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c6e8f0a71ad4457f88f8e3c3c31fd9a1, type: 3}
  m_Name: TC2_Braking
  m_EditorClassIdentifier: 
  testId: TC2
  testKind: 1
  description: Emergency braking test.
  durationSeconds: 5
  repeatCount: 1
  overrideInitialPose: 1
  initialPosition: {x: 10, y: 0, z: 0}
  initialEulerAngles: {x: 0, y: 0, z: 0}
  initialLinearVelocity: {x: 0, y: 0, z: 24.5}
  initialAngularVelocity: {x: 0, y: 0, z: 0}
  startingGear: 3
  absEnabled: 1
  tcsEnabled: 0
  frontAntiRollEnabled: 1
  rearAntiRollEnabled: 1
  surfaceOverride:
    apply: 0
    longitudinalMu: 1
    lateralMu: 1
    rollingResistance: 0.015
    decayingFriction: 0
  inputSegments:
  - startTime: 0
    endTime: 2
    steering: 0
    throttle: 0.05
    brake: 0
    clutch: 0
    handbrake: 0
  - startTime: 2
    endTime: 3
    steering: 0
    throttle: 0
    brake: 1
    clutch: 0
    handbrake: 0
  - startTime: 3
    endTime: 5
    steering: 0
    throttle: 0
    brake: 1
    clutch: 1
    handbrake: 0
  thresholds:
  - metricName: brakingDistanceM
    hasMin: 0
    minValue: 0
    hasMax: 1
    maxValue: 95
    required: 1
  - metricName: finalSpeedKmh
    hasMin: 0
    minValue: 0
    hasMax: 1
    maxValue: 5
    required: 1
